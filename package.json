{
  "name": "review-workflow",
  "version": "0.1.0",
  "private": true,
  "description": "Planner and worker agents extract invoice fields with exact source quotes, a Python validator checks them, and a human corrects and approves a local draft.",
  "type": "module",
  "engines": { "node": ">=22" },
  "main": "src/index.ts",
  "exports": { ".": "./src/index.ts" },
  "scripts": {
    "demo": "tsx src/cli/demo.ts",
    "eval": "tsx src/cli/eval.ts",
    "extract": "tsx src/cli/extract.ts",
    "review": "tsx src/cli/review.ts",
    "live": "tsx src/cli/live.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
